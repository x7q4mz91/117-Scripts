    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -30, 0, 8)
    bar.Position = UDim2.new(0, 15, 1, -14)
    bar.BackgroundColor3 = BG_HELP
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = btnBg
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    -- White Dot
    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 12, 0, 12)
    dot.Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6)
    dot.BackgroundColor3 = Color3.new(1,1,1)
    dot.BorderSizePixel = 0
    dot.ZIndex = 3
    dot.Parent = bar
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    local active = false
    local currentVal = default
    local isDragging = false

    local function applyValue(val)
        currentVal = val
        valLabel.Text = tostring(val)
        local percent = (val - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        dot.Position = UDim2.new(percent, -6, 0.5, -6)

        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum and active then
            if title == "WalkSpeed" then hum.WalkSpeed = val
            elseif title == "JumpPower" then hum.UseJumpPower = true; hum.JumpPower = val end
        end
    end

    local function setVal(percent)
        if not active then
            active = true
            badge.BackgroundColor3 = ACCENT
            badge.TextColor3 = Color3.new(1,1,1)
            badge.Text = "ON"
        end
        percent = math.clamp(percent, 0, 1)
        local val = math.floor(min + (max - min) * percent)
        if val ~= currentVal then
            applyValue(val)
        end
    end

    local function toggleState()
        active = not active
        if active then
            badge.BackgroundColor3 = ACCENT
            badge.TextColor3 = Color3.new(1,1,1)
            badge.Text = "ON"
            applyValue(currentVal)
        else
            badge.BackgroundColor3 = BG_HELP
            badge.TextColor3 = TEXT_MUTED
            badge.Text = "OFF"
            
            currentVal = default
            local percent = (default - min) / (max - min)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            dot.Position = UDim2.new(percent, -6, 0.5, -6)
            valLabel.Text = tostring(default)
            
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if title == "WalkSpeed" then hum.WalkSpeed = default
                elseif title == "JumpPower" then hum.UseJumpPower = true; hum.JumpPower = default end
            end
        end
    end

    badge.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            toggleState()
        end
    end)

    hotkeyToggles[hotkey.Name] = toggleState

    bar.MouseButton1Down:Connect(function()
        isDragging = true
        setVal(bar.MouseX / bar.AbsoluteSize.X)
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setVal((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X)
        end
    end)

    RunService.Heartbeat:Connect(function()
        if active then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if title == "WalkSpeed" then
                    if hum.WalkSpeed ~= currentVal then hum.WalkSpeed = currentVal end
                elseif title == "JumpPower" then
                    if not hum.UseJumpPower then hum.UseJumpPower = true end
                    if hum.JumpPower ~= currentVal then hum.JumpPower = currentVal end
                end
            end
        end
    end)
end


local function refreshTpList()
    for _, child in ipairs(tpListFrame:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    local filter = tpSearchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
    local entries = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local display = string.format("%s (@%s)", plr.DisplayName, plr.Name)
            local matchDN = plr.DisplayName:lower():find(filter, 1, true) ~= nil
            local matchUN = plr.Name:lower():find(filter, 1, true) ~= nil
            if filter == "" or matchDN or matchUN then
                table.insert(entries, { plr = plr, display = display })
            end
        end
    end
    table.sort(entries, function(a, b) return a.display:lower() < b.display:lower() end)

    if #entries == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -6, 0, 24)
        empty.BackgroundTransparency = 1
        empty.Text = "No players found"
        empty.TextColor3 = TEXT_MUTED
        empty.Font = Enum.Font.Gotham
        empty.TextSize = 11
        empty.TextXAlignment = Enum.TextXAlignment.Center
        empty.Parent = tpListFrame
        return
    end

    for _, entry in ipairs(entries) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 24)
        btn.BackgroundColor3 = BG_BUTTON
        btn.BackgroundTransparency = 0.05
        btn.BorderSizePixel = 0
        btn.Text = entry.display
        btn.TextColor3 = TEXT_MAIN
        btn.Font = Enum.Font.Gotham
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.AutoButtonColor = false
        btn.Parent = tpListFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0, 8); p.Parent = btn

        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = BG_HOVER end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = BG_BUTTON end)

        btn.MouseButton1Click:Connect(function()
            local char = entry.plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local myChar = LocalPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if myHrp then
                    -- Teleport 3 studs behind the player
                    myHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 3)
                    myHrp.AssemblyLinearVelocity = Vector3.zero
                    myHrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end
end
tpSearchBox:GetPropertyChangedSignal("Text"):Connect(refreshTpList)

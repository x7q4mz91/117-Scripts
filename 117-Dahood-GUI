    end
end

local function clearAllESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        local char = plr.Character
        if char then
            local h = char:FindFirstChild("117_ESP_Highlight")
            if h then h:Destroy() end
            local head = char:FindFirstChild("Head")
            if head then
                local n = head:FindFirstChild("117_ESP_Name")
                if n then n:Destroy() end
            end
        end
    end
end

local function enableESP()
    if espEnabled then return end
    espEnabled = true
    local function setupPlayer(plr)
        if plr == LocalPlayer then return end
        if plr.Character then createPlayerESP(plr) end
        table.insert(espConnections, plr.CharacterAdded:Connect(function()
            if not espEnabled then return end
            task.wait(0.3)
            if espEnabled then createPlayerESP(plr) end
        end))
        table.insert(espConnections, plr:GetPropertyChangedSignal("DisplayName"):Connect(function()
            if espEnabled then createPlayerESP(plr) end
        end))
    end
    for _, plr in ipairs(Players:GetPlayers()) do setupPlayer(plr) end
    table.insert(espConnections, Players.PlayerAdded:Connect(function(plr) if espEnabled then setupPlayer(plr) end end))
end

local function disableESP()
    espEnabled = false
    for _, c in ipairs(espConnections) do c:Disconnect() end
    espConnections = {}
    clearAllESP()
end

RunService.RenderStepped:Connect(function()
    if espEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local char = plr.Character
                if char then
                    local hl = char:FindFirstChild("117_ESP_Highlight")
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    local head = char:FindFirstChild("Head")
                    if hl and hum and hum.MaxHealth > 0 then
                        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local color = Color3.fromRGB(math.floor(255 * (1 - ratio)), math.floor(255 * ratio), 0)
                        hl.FillColor = color
                        hl.OutlineColor = color
                        if head then
                            local bb = head:FindFirstChild("117_ESP_Name")
                            if bb then
                                local nl = bb:FindFirstChild("NameLabel")
                                local hlabel = bb:FindFirstChild("HealthLabel")
                                if nl then nl.TextColor3 = color end
                                if hlabel then
                                    hlabel.TextColor3 = color
                                    hlabel.Text = string.format("%d HP", math.floor(hum.Health))
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)


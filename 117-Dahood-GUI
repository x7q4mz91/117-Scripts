    end
    task.wait(0.1)
    refreshAkList()
end)

akBtn.MouseButton1Down:Connect(function()
    if autoKillEnabled then
        stopAutoKill()
    else
        if not autoKillTarget or not autoKillTarget.Parent then
            autoKillTarget = nil
            showNotification("Select a player first", 3)
            refreshAkList()
            return
        end
        
        autoKillEnabled = true
        akBadge.Text = "ON"
        TweenService:Create(akBadge, TweenInfo.new(0.15), {BackgroundColor3 = ACCENT, TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
        
        local lChar = LocalPlayer.Character
        if lChar and lChar:FindFirstChild("HumanoidRootPart") then
            initialCFrame = lChar.HumanoidRootPart.CFrame
            lChar.HumanoidRootPart.CanCollide = false
        end
        lastE = 0
        
        task.spawn(function()
            while autoKillEnabled do
                if not autoKillTarget or not autoKillTarget.Character then break end
                local tChar = autoKillTarget.Character
                local tHum = tChar:FindFirstChildOfClass("Humanoid")
                if not tHum or tHum.Health <= 0 then break end
                if tHum.Health > 10 then
                    equipPunch()
                    task.wait(0.2)
                    if autoKillEnabled then holdM1() end
                    local start = tick()
                    while tick() - start < 4 and autoKillEnabled do task.wait(0.1) end
                    if autoKillEnabled then releaseM1() end
                    task.wait(0.1)
                else
                    task.wait(0.5)
                end
            end
            releaseM1()
        end)
        
        autoKillConn = RunService.Heartbeat:Connect(function()
            if not autoKillEnabled then return end
            if not autoKillTarget or not autoKillTarget.Parent then stopAutoKill(); return end
            local lChar = LocalPlayer.Character
            local tChar = autoKillTarget.Character
            if not lChar or not tChar then return end
            local lHRP = lChar:FindFirstChild("HumanoidRootPart")
            local lHum = lChar:FindFirstChildOfClass("Humanoid")
            local tHRP = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            if not lHRP or not lHum or not tHRP or not tHum then return end
            
            if lHum.Sit or lHum.SeatPart then pressSpace() end
            
            if tHum.Health > 10 then
                lHRP.CFrame = CFrame.new(tHRP.Position + Vector3.new(0, 1.5, 0))
                lHRP.AssemblyLinearVelocity = Vector3.zero
                lHRP.AssemblyAngularVelocity = Vector3.zero
            else
                lHRP.CFrame = tHRP.CFrame + Vector3.new(0, 4, 0)
                lHRP.AssemblyLinearVelocity = Vector3.zero
                local now = tick()
                if now - lastE > 0.2 then pressE(); lastE = now end
            end
        end)
    end
end)


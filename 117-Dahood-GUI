UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.P then
        if not mainGui.Enabled then 
            mainGui.Enabled = true 
            floatGui.Enabled = true -- Reshow camlock float button
        end
    end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if autoKillEnabled then
            stopAutoKill()
            showNotification("AutoKill forcibly stopped.", 3)
        end
    end
    
    if input.KeyCode == Enum.KeyCode.Z then
        if hotkeyToggles["Z"] then hotkeyToggles["Z"]() end
    end
    if input.KeyCode == Enum.KeyCode.X then
        if hotkeyToggles["X"] then hotkeyToggles["X"]() end
    end
    if input.KeyCode == Enum.KeyCode.B then
        toggleESP()
    end
end)


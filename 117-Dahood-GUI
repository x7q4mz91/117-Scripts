                if v.CanCollide then
                    v.CanCollide = false
                end
            end
        end
    end
end)

-- ------------------------------------------------------------
-- CAMLOCK RUNTIME (Direct Lock)
-- ------------------------------------------------------------
local smoothBox = { leftX = 0, rightX = 100, topY = 0, botY = 100, init = false }

RunService.RenderStepped:Connect(function()
    if not camlockEnabled or not camlockTarget then
        if cornerGui.Enabled then cornerGui.Enabled = false end
        smoothBox.init = false
        return
    end
    if not camlockTarget.Parent then
        camlockEnabled = false
        return
    end
    local char = camlockTarget.Character
    if not char then
        cornerGui.Enabled = false
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp or not head then
        cornerGui.Enabled = false
        return
    end

    local cam = workspace.CurrentCamera
    local targetPos = head.Position
    -- Directly lock camera (no more smooth Lerp)
    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, targetPos)

    local topPos = head.Position + Vector3.new(0, 1.2, 0)
    local botPos = hrp.Position - Vector3.new(0, 2.5, 0)
    local topS, topOn = cam:WorldToScreenPoint(topPos)
    local botS, botOn = cam:WorldToScreenPoint(botPos)

    if not topOn or not botOn then
        cornerGui.Enabled = false
        smoothBox.init = false
        return
    end

    local height = math.abs(topS.Y - botS.Y)
    height = math.clamp(height, 40, 700)
    local width = height * 0.65
    local centerX = (topS.X + botS.X) * 0.5
    local topY = math.min(topS.Y, botS.Y)
    local botY = topY + height
    local leftX = centerX - width * 0.5
    local rightX = centerX + width * 0.5

    -- Keep the corners smooth as requested initially
    local LERP = 0.35
    if not smoothBox.init then
        smoothBox.leftX = leftX; smoothBox.rightX = rightX
        smoothBox.topY = topY; smoothBox.botY = botY
        smoothBox.init = true
    else
        smoothBox.leftX = smoothBox.leftX + (leftX - smoothBox.leftX) * LERP
        smoothBox.rightX = smoothBox.rightX + (rightX - smoothBox.rightX) * LERP
        smoothBox.topY = smoothBox.topY + (topY - smoothBox.topY) * LERP
        smoothBox.botY = smoothBox.botY + (botY - smoothBox.botY) * LERP
    end

    cornerGui.Enabled = true
    corners[1].frame.Position = UDim2.new(0, smoothBox.leftX, 0, smoothBox.topY)
    corners[2].frame.Position = UDim2.new(0, smoothBox.rightX - CORNER_SIZE, 0, smoothBox.topY)
    corners[3].frame.Position = UDim2.new(0, smoothBox.leftX, 0, smoothBox.botY - CORNER_SIZE)
    corners[4].frame.Position = UDim2.new(0, smoothBox.rightX - CORNER_SIZE, 0, smoothBox.botY - CORNER_SIZE)
end)

